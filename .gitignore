__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
*.egg-info/
.env

# Озвучка воспроизводима из анкеты, поэтому WAV в репозиторий не кладём —
# 4 МБ бинарников в git ничего не дают. Манифест остаётся: он фиксирует,
# какая версия анкеты каким голосом озвучена.
#
# В проде наоборот: утверждённые Заказчиком файлы хранятся как есть
# в объектном хранилище. Утверждение §8.3 привязано к конкретным записям,
# а не к возможности их пересобрать.
media/**/*.wav

# Собранные пакеты: артефакты волн, не исходный код
exports/

# Локальный запуск для проверки вёрстки
.claude-local-run.sh

# Исходные записи голоса — биометрия, в репозиторий не попадают
media/source/
